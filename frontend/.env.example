# Copy this file to .env.local and adjust if your backend runs elsewhere.
# Mirrors the backend/.env.example pattern.

# Base URL of the FastAPI backend, including the /api/v1 prefix.
# The backend's CORS config allows http://localhost:3000 and http://127.0.0.1:3000.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
