# Copy this file to .env and fill in real values.

# Database
DATABASE_URL=sqlite:///./lms.db

# File storage (relative to backend/)
STORAGE_ROOT=storage/sessions

# Auth — generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gemini API — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_FAST_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Groq API (quota fallback) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_PRO_MODEL=llama-3.3-70b-versatile

# Demo seed users (MVP only)
DEMO_INSTRUCTOR_EMAIL=instructor@demo.com
DEMO_INSTRUCTOR_PASSWORD=instructor123
DEMO_STUDENT_EMAIL=student@demo.com
DEMO_STUDENT_PASSWORD=student123
