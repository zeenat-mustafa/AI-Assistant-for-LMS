{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "C:/ProgramData/miniconda3/python.exe",
      "runtimeArgs": [
        "-c",
        "import os, uvicorn; os.chdir('backend'); uvicorn.run('app.main:app', host='127.0.0.1', port=8000)"
      ],
      "port": 8000
    }
  ]
}
